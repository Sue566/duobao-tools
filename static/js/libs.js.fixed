/**
 * 多宝工具库
 * 版本: 1.3.0
 * 最后更新: 2025-08-08
 *
 * 这是一个全面的前端工具库，提供了丰富的功能模块：
 * - 通用工具函数
 * - 文件处理
 * - 图像处理
 * - 颜色处理
 * - 数学计算
 * - 日期时间处理
 * - 字符串处理
 * - 数组操作
 * - 对象操作
 * - 网络请求
 * - 存储管理
 */

// 通用工具函数
const DuobaoUtils = {
  // 格式化日期
  formatDate: function(date, format) {
    const o = {
      "M+": date.getMonth() + 1,
      "d+": date.getDate(),
      "h+": date.getHours(),
      "m+": date.getMinutes(),
      "s+": date.getSeconds(),
      "q+": Math.floor((date.getMonth() + 3) / 3),
      "S": date.getMilliseconds()
    };

    if (/(y+)/.test(format)) {
      format = format.replace(RegExp.$1, (date.getFullYear() + "").substr(4 - RegExp.$1.length));
    }

    for (let k in o) {
      if (new RegExp("(" + k + ")").test(format)) {
        format = format.replace(RegExp.$1, (RegExp.$1.length == 1) ? (o[k]) : (("00" + o[k]).substr(("" + o[k]).length)));
      }
    }

    return format;
  },

  // 生成UUID
  generateUUID: function() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
      const r = Math.random() * 16 | 0;
      const v = c === 'x' ? r : (r & 0x3 | 0x8);
      return v.toString(16);
    });
  },
  
  // 深拷贝对象
  deepClone: function(obj) {
    if (obj === null || typeof obj !== 'object') {
      return obj;
    }
    
    if (obj instanceof Date) {
      return new Date(obj);
    }
    
    if (obj instanceof Array) {
      return obj.map(item => this.deepClone(item));
    }
    
    if (obj instanceof Object) {
      const copy = {};
      for (const key in obj) {
        if (obj.hasOwnProperty(key)) {
          copy[key] = this.deepClone(obj[key]);
        }
      }
      return copy;
    }
    
    throw new Error('无法复制对象: ' + obj);
  },
  
  // 防抖函数
  debounce: function(func, wait, immediate) {
    let timeout;
    return function() {
      const context = this;
      const args = arguments;
      
      const later = function() {
        timeout = null;
        if (!immediate) func.apply(context, args);
      };
      
      const callNow = immediate && !timeout;
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
      
      if (callNow) func.apply(context, args);
    };
  },
  
  // 节流函数
  throttle: function(func, limit) {
    let inThrottle;
    return function() {
      const context = this;
      const args = arguments;
      
      if (!inThrottle) {
        func.apply(context, args);
        inThrottle = true;
        setTimeout(() => inThrottle = false, limit);
      }
    };
  },
  
  // 获取URL参数
  getUrlParam: function(name) {
    const url = window.location.href;
    name = name.replace(/[\[\]]/g, '\\$&');
    const regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)');
    const results = regex.exec(url);
    
    if (!results) return null;
    if (!results[2]) return '';
    
    return decodeURIComponent(results[2].replace(/\+/g, ' '));
  },
  
  // 格式化数字
  formatNumber: function(num, digits = 2) {
    const si = [
      { value: 1E18, symbol: 'E' },
      { value: 1E15, symbol: 'P' },
      { value: 1E12, symbol: 'T' },
      { value: 1E9, symbol: 'G' },
      { value: 1E6, symbol: 'M' },
      { value: 1E3, symbol: 'k' }
    ];
    
    for (let i = 0; i < si.length; i++) {
      if (num >= si[i].value) {
        return (num / si[i].value).toFixed(digits) + si[i].symbol;
      }
    }
    
    return num.toFixed(digits);
  },
  
  // 随机整数
  randomInt: function(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  },
  
  // 随机颜色
  randomColor: function() {
    return '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0');
  },
  
  // 检查是否为移动设备
  isMobile: function() {
    return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  },
  
  // 检查是否为邮箱
  isEmail: function(email) {
    const re = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
    return re.test(String(email).toLowerCase());
  },
  
  // 检查是否为URL
  isUrl: function(url) {
    const pattern = new RegExp('^(https?:\\/\\/)?'+ // 协议
      '((([a-z\\d]([a-z\\d-]*[a-z\\d])*)\\.)+[a-z]{2,}|'+ // 域名
      '((\\d{1,3}\\.){3}\\d{1,3}))'+ // IP地址
      '(\\:\\d+)?(\\/[-a-z\\d%_.~+]*)*'+ // 端口和路径
      '(\\?[;&a-z\\d%_.~+=-]*)?'+ // 查询字符串
      '(\\#[-a-z\\d_]*)?$','i'); // 锚点
    return pattern.test(url);
  },
  
  // 检查是否为手机号
  isPhone: function(phone) {
    return /^1[3456789]\d{9}$/.test(phone);
  },
  
  // 检查是否为身份证号
  isIdCard: function(id) {
    return /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/.test(id);
  },
  
  // 格式化文件大小
  formatFileSize: function(bytes) {
    if (bytes === 0) return '0 B';
    
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  },
  
  // 复制文本到剪贴板
  copyToClipboard: function(text) {
    if (navigator.clipboard && window.isSecureContext) {
      // 使用现代API
      return navigator.clipboard.writeText(text);
    } else {
      // 兼容方案
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.opacity = '0';
      document.body.appendChild(textArea);
      textArea.select();
      
      try {
        return document.execCommand('copy');
      } catch (err) {
        console.error('复制失败:', err);
        return false;
      } finally {
        document.body.removeChild(textArea);
      }
    }
  },
  
  // 获取浏览器信息
  getBrowserInfo: function() {
    const ua = navigator.userAgent;
    let browser = 'Unknown';
    let version = 'Unknown';
    
    // 检测浏览器
    if (ua.indexOf('Edge') > -1) {
      browser = 'Microsoft Edge';
      version = ua.match(/Edge\/(\d+\.\d+)/)[1];
    } else if (ua.indexOf('Firefox') > -1) {
      browser = 'Mozilla Firefox';
      version = ua.match(/Firefox\/(\d+\.\d+)/)[1];
    } else if (ua.indexOf('Chrome') > -1) {
      browser = 'Google Chrome';
      version = ua.match(/Chrome\/(\d+\.\d+)/)[1];
    } else if (ua.indexOf('Safari') > -1) {
      browser = 'Apple Safari';
      version = ua.match(/Version\/(\d+\.\d+)/)[1];
    } else if (ua.indexOf('MSIE') > -1 || ua.indexOf('Trident/') > -1) {
      browser = 'Internet Explorer';
      version = ua.match(/MSIE (\d+\.\d+)/) ? ua.match(/MSIE (\d+\.\d+)/)[1] : '11.0';
    }
    
    return {
      browser: browser,
      version: version,
      os: this.getOSInfo(),
      userAgent: ua
    };
  },
  
  // 获取操作系统信息
  getOSInfo: function() {
    const ua = navigator.userAgent;
    let os = 'Unknown';
    
    if (ua.indexOf('Win') > -1) {
      os = 'Windows';
    } else if (ua.indexOf('Mac') > -1) {
      os = 'MacOS';
    } else if (ua.indexOf('Linux') > -1) {
      os = 'Linux';
    } else if (ua.indexOf('Android') > -1) {
      os = 'Android';
    } else if (ua.indexOf('iPhone') > -1 || ua.indexOf('iPad') > -1) {
      os = 'iOS';
    }
    
    return os;
  },
  
  // 获取设备类型
  getDeviceType: function() {
    const ua = navigator.userAgent;
    
    if (/iPad|tablet|Nexus 9|Nexus 10/i.test(ua)) {
      return 'Tablet';
    } else if (/iPhone|Android|webOS|BlackBerry|Windows Phone/i.test(ua)) {
      return 'Mobile';
    } else {
      return 'Desktop';
    }
  },
  
  // 检查元素是否在视口中
  isInViewport: function(element) {
    const rect = element.getBoundingClientRect();
    
    return (
      rect.top >= 0 &&
      rect.left >= 0 &&
      rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
      rect.right <= (window.innerWidth || document.documentElement.clientWidth)
    );
  },
  
  // 滚动到指定元素
  scrollToElement: function(element, offset = 0, behavior = 'smooth') {
    const rect = element.getBoundingClientRect();
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    
    window.scrollTo({
      top: rect.top + scrollTop - offset,
      behavior: behavior
    });
  },
  
  // 获取元素的绝对位置
  getAbsolutePosition: function(element) {
    const rect = element.getBoundingClientRect();
    
    return {
      top: rect.top + window.pageYOffset,
      left: rect.left + window.pageXOffset,
      width: rect.width,
      height: rect.height
    };
  },
  
  // 添加事件监听
  addEvent: function(element, event, handler, options = false) {
    if (element.addEventListener) {
      element.addEventListener(event, handler, options);
    } else if (element.attachEvent) {
      element.attachEvent('on' + event, handler);
    } else {
      element['on' + event] = handler;
    }
  },
  
  // 移除事件监听
  removeEvent: function(element, event, handler, options = false) {
    if (element.removeEventListener) {
      element.removeEventListener(event, handler, options);
    } else if (element.detachEvent) {
      element.detachEvent('on' + event, handler);
    } else {
      element['on' + event] = null;
    }
  },
  
  // 创建自定义事件
  createCustomEvent: function(eventName, detail = {}) {
    let event;
    
    if (typeof window.CustomEvent === 'function') {
      event = new CustomEvent(eventName, { detail: detail, bubbles: true, cancelable: true });
    } else {
      event = document.createEvent('CustomEvent');
      event.initCustomEvent(eventName, true, true, detail);
    }
    
    return event;
  },
  
  // 触发自定义事件
  dispatchCustomEvent: function(element, eventName, detail = {}) {
    const event = this.createCustomEvent(eventName, detail);
    element.dispatchEvent(event);
  },
  
  // 获取Cookie
  getCookie: function(name) {
    const match = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
    return match ? decodeURIComponent(match[3]) : null;
  },
  
  // 设置Cookie
  setCookie: function(name, value, days = 30, path = '/') {
    let expires = '';
    
    if (days) {
      const date = new Date();
      date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
      expires = '; expires=' + date.toUTCString();
    }
    
    document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=' + path;
  },
  
  // 删除Cookie
  deleteCookie: function(name, path = '/') {
    this.setCookie(name, '', -1, path);
  },
  
  // 检查是否支持本地存储
  isLocalStorageSupported: function() {
    try {
      const test = '__test__';
      localStorage.setItem(test, test);
      localStorage.removeItem(test);
      return true;
    } catch (e) {
      return false;
    }
  },
  
  // 检查是否支持会话存储
  isSessionStorageSupported: function() {
    try {
      const test = '__test__';
      sessionStorage.setItem(test, test);
      sessionStorage.removeItem(test);
      return true;
    } catch (e) {
      return false;
    }
  },
  
  // 加载脚本
  loadScript: function(url, callback) {
    const script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = url;
    
    if (callback) {
      script.onload = callback;
    }
    
    document.head.appendChild(script);
  },
  
  // 加载样式
  loadStyle: function(url, callback) {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = url;
    
    if (callback) {
      link.onload = callback;
    }
    
    document.head.appendChild(link);
  },
  
  // 动态加载图片
  loadImage: function(url) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = url;
    });
  },
  
  // 检测设备方向
  getDeviceOrientation: function() {
    if (window.matchMedia("(orientation: portrait)").matches) {
      return 'portrait';
    } else {
      return 'landscape';
    }
  },
  
  // 检测是否支持触摸事件
  isTouchDevice: function() {
    return 'ontouchstart' in window || navigator.maxTouchPoints > 0 || navigator.msMaxTouchPoints > 0;
  },
  
  // 获取当前页面URL
  getCurrentUrl: function() {
    return window.location.href;
  },
  
  // 获取当前页面路径
  getCurrentPath: function() {
    return window.location.pathname;
  },
  
  // 获取当前页面查询参数
  getQueryParams: function() {
    const params = {};
    const query = window.location.search.substring(1);
    const vars = query.split('&');
    
    for (let i = 0; i < vars.length; i++) {
      if (vars[i]) {
        const pair = vars[i].split('=');
        params[decodeURIComponent(pair[0])] = decodeURIComponent(pair[1] || '');
      }
    }
    
    return params;
  },
  
  // 构建查询字符串
  buildQueryString: function(params) {
    return Object.keys(params)
      .map(key => encodeURIComponent(key) + '=' + encodeURIComponent(params[key]))
      .join('&');
  },
  
  // 重定向到URL
  redirect: function(url) {
    window.location.href = url;
  },
  
  // 刷新页面
  refreshPage: function() {
    window.location.reload();
  },
  
  // 获取浏览器语言
  getBrowserLanguage: function() {
    return navigator.language || navigator.userLanguage;
  },
  
  // 检测是否为暗模式
  isDarkMode: function() {
    return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  },
  
  // 监听暗模式变化
  watchDarkMode: function(callback) {
    if (window.matchMedia) {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      mediaQuery.addListener(callback);
      return mediaQuery;
    }
    return null;
  },
  
  // 格式化时间戳
  formatTimestamp: function(timestamp, format = 'YYYY-MM-DD HH:mm:ss') {
    const date = new Date(timestamp);
    return this.formatDate(date, format);
  },
  
  // 获取相对时间
  getRelativeTime: function(timestamp) {
    const now = Date.now();
    const diff = now - timestamp;
    
    const seconds = Math.floor(diff / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);
    const months = Math.floor(days / 30);
    const years = Math.floor(months / 12);
    
    if (years > 0) {
      return years + '年前';
    } else if (months > 0) {
      return months + '个月前';
    } else if (days > 0) {
      return days + '天前';
    } else if (hours > 0) {
      return hours + '小时前';
    } else if (minutes > 0) {
      return minutes + '分钟前';
    } else {
      return '刚刚';
    }
  },
  
  // 生成随机字符串
  randomString: function(length = 8, chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789') {
    let result = '';
    const charsLength = chars.length;
    
    for (let i = 0; i < length; i++) {
      result += chars.charAt(Math.floor(Math.random() * charsLength));
    }
    
    return result;
  },
  
  // 检测浏览器是否在线
  isOnline: function() {
    return navigator.onLine;
  },
  
  // 监听在线状态变化
  watchOnlineStatus: function(onlineCallback, offlineCallback) {
    window.addEventListener('online', onlineCallback);
    window.addEventListener('offline', offlineCallback);
    
    return {
      remove: function() {
        window.removeEventListener('online', onlineCallback);
        window.removeEventListener('offline', offlineCallback);
      }
    };
  },
  
  // 获取设备像素比
  getDevicePixelRatio: function() {
    return window.devicePixelRatio || 1;
  },
  
  // 检测是否支持WebP格式
  isWebpSupported: function() {
    const elem = document.createElement('canvas');
    
    if (elem.getContext && elem.getContext('2d')) {
      return elem.toDataURL('image/webp').indexOf('data:image/webp') === 0;
    }
    
    return false;
  },
  
  // 检测是否支持特定CSS属性
  isCssPropertySupported: function(property) {
    return property in document.documentElement.style;
  },
  
  // 检测是否支持特定CSS值
  isCssValueSupported: function(property, value) {
    const elem = document.createElement('div');
    elem.style[property] = value;
    return elem.style[property] === value;
  },
  
  // 获取元素CSS属性值
  getCssProperty: function(element, property) {
    return window.getComputedStyle(element).getPropertyValue(property);
  },
  
  // 设置元素CSS属性
  setCssProperty: function(element, property, value) {
    element.style[property] = value;
  },
  
  // 添加类名
  addClass: function(element, className) {
    if (element.classList) {
      element.classList.add(className);
    } else {
      element.className += ' ' + className;
    }
  },
  
  // 移除类名
  removeClass: function(element, className) {
    if (element.classList) {
      element.classList.remove(className);
    } else {
      element.className = element.className.replace(new RegExp('(^|\\b)' + className.split(' ').join('|') + '(\\b|$)', 'gi'), ' ');
    }
  },
  
  // 切换类名
  toggleClass: function(element, className) {
    if (element.classList) {
      element.classList.toggle(className);
    } else {
      const classes = element.className.split(' ');
      const existingIndex = classes.indexOf(className);
      
      if (existingIndex >= 0) {
        classes.splice(existingIndex, 1);
      } else {
        classes.push(className);
      }
      
      element.className = classes.join(' ');
    }
  },
  
  // 检查是否包含类名
  hasClass: function(element, className) {
    if (element.classList) {
      return element.classList.contains(className);
    } else {
      return new RegExp('(^| )' + className + '( |$)', 'gi').test(element.className);
    }
  },
  
  // 获取元素的兄弟元素
  getSiblings: function(element) {
    const siblings = [];
    let sibling = element.parentNode.firstChild;
    
    while (sibling) {
      if (sibling.nodeType === 1 && sibling !== element) {
        siblings.push(sibling);
      }
      sibling = sibling.nextSibling;
    }
    
    return siblings;
  },
  
  // 获取元素的下一个兄弟元素
  getNextSibling: function(element) {
    let sibling = element.nextSibling;
    
    while (sibling && sibling.nodeType !== 1) {
      sibling = sibling.nextSibling;
    }
    
    return sibling;
  },
  
  // 获取元素的上一个兄弟元素
  getPreviousSibling: function(element) {
    let sibling = element.previousSibling;
    
    while (sibling && sibling.nodeType !== 1) {
      sibling = sibling.previousSibling;
    }
    
    return sibling;
  },
  
  // 获取元素的第一个子元素
  getFirstChild: function(element) {
    let child = element.firstChild;
    
    while (child && child.nodeType !== 1) {
      child = child.nextSibling;
    }
    
    return child;
  },
  
  // 获取元素的最后一个子元素
  getLastChild: function(element) {
    let child = element.lastChild;
    
    while (child && child.nodeType !== 1) {
      child = child.previousSibling;
    }
    
    return child;
  },
  
  // 获取元素的所有子元素
  getChildren: function(element) {
    const children = [];
    let child = element.firstChild;
    
    while (child) {
      if (child.nodeType === 1) {
        children.push(child);
      }
      child = child.nextSibling;
    }
    
    return children;
  },
  
  // 创建元素
  createElement: function(tag, attributes = {}, content = '') {
    const element = document.createElement(tag);
    
    for (const key in attributes) {
      if (attributes.hasOwnProperty(key)) {
        element.setAttribute(key, attributes[key]);
      }
    }
    
    if (content) {
      element.innerHTML = content;
    }
    
    return element;
  },
  
  // 移除元素
  removeElement: function(element) {
    if (element && element.parentNode) {
      element.parentNode.removeChild(element);
    }
  },
  
  // 插入元素到指定位置
  insertElement: function(parent, element, position = 'append') {
    switch (position) {
      case 'prepend':
        parent.insertBefore(element, parent.firstChild);
        break;
      case 'before':
        parent.parentNode.insertBefore(element, parent);
        break;
      case 'after':
        parent.parentNode.insertBefore(element, parent.nextSibling);
        break;
      case 'append':
      default:
        parent.appendChild(element);
    }
  },
  
  // 替换元素
  replaceElement: function(oldElement, newElement) {
    if (oldElement.parentNode) {
      oldElement.parentNode.replaceChild(newElement, oldElement);
    }
  },
  
  // 清空元素内容
  emptyElement: function(element) {
    while (element.firstChild) {
      element.removeChild(element.firstChild);
    }
  },
  
  // 获取元素内容
  getElementContent: function(element) {
    return element.textContent || element.innerText;
  },
  
  // 设置元素内容
  setElementContent: function(element, content) {
    element.textContent = content;
  },
  
  // 获取元素属性
  getElementAttribute: function(element, attribute) {
    return element.getAttribute(attribute);
  },
  
  // 设置元素属性
  setElementAttribute: function(element, attribute, value) {
    element.setAttribute(attribute, value);
  },
  
  // 移除元素属性
  removeElementAttribute: function(element, attribute) {
    element.removeAttribute(attribute);
  },
  
  // 检查元素是否有属性
  hasElementAttribute: function(element, attribute) {
    return element.hasAttribute(attribute);
  },
  
  // 获取元素数据属性
  getElementData: function(element, key) {
    return element.dataset[key];
  },
  
  // 设置元素数据属性
  setElementData: function(element, key, value) {
    element.dataset[key] = value;
  },
  
  // 移除元素数据属性
  removeElementData: function(element, key) {
    delete element.dataset[key];
  },
  
  // 检查元素是否有数据属性
  hasElementData: function(element, key) {
    return key in element.dataset;
  },
  
  // 获取元素的所有数据属性
  getAllElementData: function(element) {
    return { ...element.dataset